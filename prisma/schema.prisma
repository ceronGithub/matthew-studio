// FILE: prisma/schema.prisma
// PURPOSE:
// Prisma 7.10 schema for matthew-studio. As of 7.10, the `url` field is
// no longer accepted inside this file's datasource block at all — it
// must live only in prisma.config.mjs (DIRECT_URL, session pooler, port
// 5432), which the CLI (generate/db push/migrate) reads instead. The
// app's own runtime client is built separately with the pg driver
// adapter in services/prisma.ts using DATABASE_URL (transaction pooler,
// port 6543) — neither one reads a url from this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// RateLimitAttempt
/// One row per request attempt against a rate-limited endpoint (login,
/// register). lib/rateLimit.ts counts rows for a given ipAddress +
/// endpoint within the trailing window instead of maintaining a
/// read-modify-write counter — safe under concurrent requests since
/// every attempt is an independent insert, never an update.
/// Rows are disposable: safe to periodically delete anything older
/// than the longest window in use (15 minutes) if this table grows.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  endpoint  String // "login" | "register"
  createdAt DateTime @default(now())

  @@index([ipAddress, endpoint, createdAt])
}

/// SecurityLog
/// Append-only record of auth-related security events — separate from
/// RateLimitAttempt (which only tracks request counts). Basic version:
/// event + actor + request metadata (IP, user agent, parsed
/// browser/OS). Geolocation fields are left out for now since they'd
/// require a MaxMind GeoLite2 database that has to be downloaded
/// manually — can be added later without breaking this shape.
model SecurityLog {
  id             String   @id @default(cuid())
  eventType      String // login_success | login_failed | registration_failed
  actor          String? // email, nullable when the attempt never resolved to one
  details        String? // human-readable one-liner
  ipAddress      String?
  userAgent      String?
  deviceType     String? // mobile | tablet | desktop
  browserName    String?
  browserVersion String?
  osName         String?
  osVersion      String?
  createdAt      DateTime @default(now())

  @@index([eventType])
  @@index([actor])
  @@index([createdAt])
}

/// CartItem
/// One row per line item in a cart — either a buyer's (userId set) or a
/// guest's (cartToken set instead, matching the signed cookie value).
/// Never both null/both set for the same row — the API layer enforces
/// exactly one is present per cart_checkout_specification.md Section 2.
/// Disposable/transient by nature (unlike Order), so no soft delete —
/// removing an item from a cart is a real delete.
model CartItem {
  id        String   @id @default(cuid())
  userId    String? // null for guest carts (cartToken used instead)
  cartToken String? // guest cart identifier, null for buyer carts
  productId String
  variant   String? // e.g. design variant, size/color
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([cartToken])
}

/// Order
/// Created "pending" at checkout submit (cart_checkout_specification.md
/// Section 4.4) with a PayMongo Payment Link id; the PayMongo webhook —
/// and only the webhook (Rule 30.3) — later flips status to "PAID" and
/// fills in the three webhook-owned fields below. Sensitive record per
/// Rule 6: soft-deleted (deletedAt) rather than hard-deleted, and
/// updatedAt tracked for optimistic-lock checks on concurrent writes.
model Order {
  id                String    @id @default(cuid())
  userId            String? // null if guest checkout, claimable later
  guestEmail        String?
  cartToken         String? // guest cart_token this Order was created from — lets the webhook/self-heal endpoint clear the correct guest cart without ever trusting a client-submitted value
  status            String    @default("pending") // pending | PAID | FAILED | Confirmed | Shipped | Delivered | Cancelled — FAILED means PayMongo reported the checkout session as failed/expired; the Order stays in place (never deleted) so the buyer can retry via /api/orders/[orderId]/retry-payment instead of re-adding their whole cart
  subtotal          Float
  shippingFee       Float     @default(0)
  total             Float
  paymongoOrderId   String?   @unique // Payment Link ID
  paymongoPaymentId String? // set by webhook, Rule 30.1
  paymentStatus     String? // set by webhook, Rule 30.1
  paidAt            DateTime? // set by webhook, Rule 30.1
  productionStage   String? // t-shirt orders only, per buyer_order_tracking_specification.md
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // Rule 6 soft delete — excluded from normal reads by default

  items OrderItem[]

  @@index([userId])
  @@index([guestEmail])
  @@index([status])
}

/// OrderItem
/// Snapshots product name/price/variant at time of purchase (never a
/// live join to the product table) so a later catalog price change
/// never retroactively alters a past order's total.
model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  productId     String
  nameSnapshot  String
  priceSnapshot Float
  variant       String?
  quantity      Int

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

/// Product
/// Base catalog fields mirror lib/productsData.ts's Product interface —
/// no formal Prisma block existed for this before (only the media
/// add-on fields were spec'd, in product_media_upload_specification.md).
/// `startingPrice` is the one universal sort/filter value every
/// category has; `pricingDetails`/`variants` are Json since only
/// Templates use the managed/self-hosted/custom tier breakdown and
/// variant list — every other category leaves them null rather than
/// carrying unused columns. Soft-deleted (deletedAt) since products
/// are admin-managed content, not disposable rows.
model Product {
  id            String    @id @default(cuid())
  slug          String    @unique
  category      String // ProductCategorySlug: templates | tshirts | ai-videos | file-tools | tutorials | game-characters
  categoryLabel String
  name          String
  description   String
  iconName      String
  startingPrice Float // universal sort/filter value, all categories
  pricingDetails Json? // { managed?: {monthly, annual}, selfHosted?: number, custom?: number } — Templates only
  ratingAverage Float     @default(0)
  ratingCount   Int       @default(0)
  badge         String? // "bestseller" | "new" | "limited"
  dateAdded     DateTime  @default(now())
  trendingScore Float     @default(0)
  variants      Json? // ProductVariant[] — Templates only
  status        String    @default("draft") // draft | published

  // Media fields — product_media_upload_specification.md Section 6
  coverImageUrl   String? // R2 public URL, products/<id>/cover.webp
  coverImageKey   String? // R2 key, needed for deletion/replacement
  previewVideoUrl String? // R2 public URL, products/<id>/video/<uuid>.<ext>
  previewVideoKey String?
  galleryImages   ProductGalleryImage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Rule 6 soft delete — excluded from normal reads by default

  @@index([category])
  @@index([status])
  @@index([slug])
}

/// ProductGalleryImage
/// Up to 8 per product per product_media_upload_specification.md
/// Section 9's checklist. sortOrder matches the reorderable strip in
/// the admin gallery editor (Section 4).
model ProductGalleryImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  key       String
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// AdminSession
/// One row per admin/super-admin login — holds the auto-generated
/// session slug (vault_specification.md Section 2). Reused across
/// requests while isActive; a fresh row (never a reused slug) is
/// created on every post-logout login. userId references Supabase
/// auth.users.id as a plain string — no local User table (Supabase
/// Auth is the single source of identity; role lives in
/// user_metadata.role, read in middleware.ts).
model AdminSession {
  id     String @id @default(cuid())
  userId String
  role   String // "superAdmin" | "admin"

  slug     Json // { words: string[], alphanumeric, alphaspecial? }
  isActive Boolean @default(true)

  loginAt        DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  signedOutAt    DateTime?
  expiresAt      DateTime // 24 hours from login

  ipAddress  String?
  userAgent  String?
  deviceType String? // "mobile" | "tablet" | "desktop"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
}

/// VaultCredentials
/// Metadata only for offline emergency-access credentials
/// (vault_specification.md Section 3) — the actual 15 words + 15
/// alphanumeric are NEVER stored, only their SHA-256 hashes, for
/// audit-trail purposes.
model VaultCredentials {
  id             String @id @default(cuid())
  userId         String
  adminSessionId String
  role           String // "superAdmin" | "admin"

  wordsHash        String
  alphanumericHash String

  generatedAt DateTime  @default(now())
  expiresAt   DateTime // 24 hours from generation, metadata only — no enforcement
  accessedAt  DateTime?

  generatedBy String? // super-admin email if generated on behalf of another admin

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([adminSessionId])
  @@index([expiresAt])
}

/// GatekeeperEvent
/// Vault-page emergency actions log (vault_specification.md Section
/// 12.7) — backup/wipe/lockdown/unblock actions taken from the Vault's
/// Emergency Actions panel. Distinct from DeviceBan below, which is
/// the site-wide automatic ban system (gatekeeper_specification.md).
model GatekeeperEvent {
  id          String @id @default(cuid())
  eventType   String // sql_injection_attempt | force_entry_attempt | auto_lockdown | manual_lockdown | database_wipe | vault_wipe | account_unblocked | block_all_accounts
  triggeredBy String? // super-admin/admin email if manual; null if automated
  ipAddress   String?
  details     String?

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

/// DeviceBan
/// Site-wide device-fingerprint ban list (gatekeeper_specification.md
/// Section 5) — checked on every request in middleware.ts before any
/// role-based routing. Permanent until a super-admin manually unbans
/// (Section 8); one active row per device, since a second breach from
/// an already-banned device never reaches the code that would log a
/// new strike.
model DeviceBan {
  id                String   @id @default(cuid())
  deviceFingerprint String   @unique
  reason            String // human-readable, e.g. "3x admin_login_denied within 24h"
  triggerEventType  String // the eventType that caused the ban, or "manual"
  strikeCount       Int? // null for instant-ban triggers, 3 for strike-based
  relatedLogIds     String[] // SecurityLog row IDs that led to the ban, for audit review

  bannedAt DateTime @default(now())
  bannedBy String   @default("system") // "system" (auto) or super-admin's ID/email (manual)

  isActive   Boolean   @default(true)
  unbannedAt DateTime?
  unbannedBy String? // super-admin's ID/email
  unbanNote  String? // required when unbanning, Section 8

  createdAt DateTime @default(now())

  @@index([deviceFingerprint])
  @@index([isActive])
}

/// BuyerDownload
/// One row per digital item a buyer owns — created once at order
/// fulfillment time (never here) for Templates/File Tools purchases,
/// per buyer_account_specification.md Section 4.1. T-shirt orders and
/// AI Video jobs never get a row here — those live in Order History /
/// a future "My AI Videos" list instead. licenseKey is set once and
/// never re-issued on repeat download (Section 8 checklist); r2Key is
/// the private object key used to mint a fresh signed URL per request
/// — never the public bucket URL, since these are paid, ownership-
/// gated files.
model BuyerDownload {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  licenseKey  String?
  r2Key       String?
  purchasedAt DateTime @default(now())

  @@index([userId])
}
