// FILE: prisma/schema.prisma
// PURPOSE:
// Prisma 7.10 schema for matthew-studio. As of 7.10, the `url` field is
// no longer accepted inside this file's datasource block at all — it
// must live only in prisma.config.mjs (DIRECT_URL, session pooler, port
// 5432), which the CLI (generate/db push/migrate) reads instead. The
// app's own runtime client is built separately with the pg driver
// adapter in services/prisma.ts using DATABASE_URL (transaction pooler,
// port 6543) — neither one reads a url from this file.
//
// Add models below as features are built. Kept empty for now per request —
// just scaffolding, ready to receive tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Models go here. Example shape for reference (not created yet):
